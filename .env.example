# AI-ассистент (Claude). Без ключа сайт работает, но ассистент выключен.
ANTHROPIC_API_KEY=sk-ant-...
# Модель (по умолчанию claude-opus-5)
# KM_MODEL=claude-opus-5

# Redis (Vercel Marketplace → Upstash Redis). Интеграция Vercel создаёт эти переменные сама.
# Без них данные хранятся в памяти (локально — в файле .data/db.json).
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=...
# Альтернативные имена тоже поддерживаются:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# CORS: откуда можно вызывать API (по умолчанию * — любой сайт)
# ALLOWED_ORIGIN=https://kicad-master.vercel.app

# Только для локального сервера
# PORT=8080
# LOCAL_DB=.data/db.json

# Вместо ANTHROPIC_API_KEY можно использовать ключ OpenRouter (openrouter.ai/keys).
# Если заданы оба — используется Anthropic. Модель по умолчанию: anthropic/claude-opus-5.
# OPENROUTER_API_KEY=sk-or-...
# SITE_URL=https://ваш-проект.vercel.app

# Выбор модели посетителями на странице /models:
# максимум цены вывода, $ за 1 млн токенов (по умолчанию 30)
# KM_MAX_PRICE=30
# или явный список разрешённых моделей (через запятую, можно *)
# KM_ALLOWED_MODELS=anthropic/*,google/gemini-2.5-flash
